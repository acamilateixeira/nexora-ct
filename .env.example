APP_NAME="Carteira"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr_json
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wallet
DB_USERNAME=app
DB_PASSWORD=app-local-secret

DB_MIGRATOR_USERNAME=migrator
DB_MIGRATOR_PASSWORD=migrator-local-secret

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=carteira@example.com
MAIL_FROM_NAME="${APP_NAME}"

ATENDIMENTO_TELEFONE="0800 000 0000"
ATENDIMENTO_EMAIL=atendimento@exemplo.com
